# Platinum staging and model access
PLATINUM_AUTH_TOKEN=
PLATINUM_MODEL=
PLATINUM_URL=https://platinum.adaptstaging.com/v1

# GitHub fine-grained personal access token, limited to the repositories the agent needs
GITHUB_TOKEN=

# ACP Patchbay client token
ACP_TOKEN=

MODEL_VAULT=
ACP_VAULT=
# ADAPT_VOLUME=basin://org/volume
# SANDBOX_IMAGE=gcr.io/adapt-developer/adapt-agent.ubuntu:v26.09.2
# 0 keeps the deployment alive until explicitly stopped; charges continue.
SANDBOX_TTL_SECONDS=0
# SANDBOX_MEMORY_MIB=1024

# GCP service account with read-only GKE, Kubernetes, and Cloud Logging access
GCP_SERVICE_ACCOUNT_JSON=
GCP_STAGING_PROJECT_ID=adapt-developer
GCP_STAGING_CLUSTER=adapt-staging
GCP_STAGING_CLUSTER_LOCATION=us-central1
GCP_KUBERNETES_NAMESPACE=staging
# GCP_CLOUD_LOGGING_PROJECT_ID=adapt-developer
